{
  "schemaVersion": 1,
  "runtimes": {
    "codex-local": {
      "adapter": "codex",
      "executable": "/opt/homebrew/bin/codex",
      "model": "gpt-5.6-sol",
      "effort": "low"
    },
    "claude-local": {
      "adapter": "claude-code",
      "executable": "/Users/shebin_mohan_k/.local/bin/claude",
      "model": "sonnet",
      "effort": "low"
    }
  },
  "defaults": {
    "workerAgent": "engineer-codex",
    "maxActiveTurns": 2,
    "maxActiveWriters": 2,
    "maxTasksPerRun": 8,
    "maxDelegationDepth": 2,
    "maxRepairAttempts": 1,
    "maxTransientRetries": 1,
    "runTimeoutMinutes": 20,
    "plannerAgent": "engineer-codex"
  },
  "agents": [
    {
      "id": "engineer-codex",
      "runtime": "codex-local",
      "instructions": "Do exactly what the task asks, then stop. Do not add unrequested files.",
      "capabilities": [
        "coding",
        "testing"
      ],
      "policy": "local-development"
    },
    {
      "id": "engineer-claude",
      "runtime": "claude-local",
      "instructions": "Do exactly what the task asks, then stop. Do not add unrequested files.",
      "capabilities": [
        "coding",
        "testing"
      ],
      "policy": "local-development"
    }
  ]
}