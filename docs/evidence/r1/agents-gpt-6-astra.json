{
  "schemaVersion": 1,
  "runtimes": {
    "codex-local": { "adapter": "codex", "executable": "/opt/homebrew/bin/codex", "model": "gpt-6-astra", "effort": "low" },
    "claude-local": { "adapter": "claude-code", "executable": "/Users/shebin_mohan_k/.local/bin/claude", "model": "sonnet", "effort": "low" }
  },
  "defaults": {
    "workerAgent": "engineer-codex",
    "plannerAgent": "engineer-codex",
    "maxActiveTurns": 2,
    "maxActiveWriters": 2,
    "maxTasksPerRun": 8,
    "maxDelegationDepth": 2,
    "maxRepairAttempts": 1,
    "maxTransientRetries": 0,
    "runTimeoutMinutes": 20
  },
  "agents": [
    { "id": "engineer-codex", "runtime": "codex-local", "instructions": "Do exactly what the task asks, then stop. Do not add unrequested files.", "capabilities": ["coding","testing"], "policy": "local-development" },
    { "id": "engineer-claude", "runtime": "claude-local", "instructions": "Do exactly what the task asks, then stop. Do not add unrequested files.", "capabilities": ["coding","testing"], "policy": "local-development" }
  ]
