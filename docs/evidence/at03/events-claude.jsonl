t be greater than zero');\n  if (total <= 0) return 0;\n  return Math.ceil(total / pageSize);\n}\n\n/**\n * The items on a 1-based `page`.\n */\nexport function paginate(items, page, pageSize) {\n  if (pageSize <= 0) throw new RangeError('pageSize must be greater than zero');\n  if (page < 1) throw new RangeError('page is 1-based');\n  const start = (page - 1) * pageSize;\n  return items.slice(start, start + pageSize);\n}"}},"payloadRef":null,"idempotencyKey":"claude-code:01a07cbe-2046-7555-b2e5-b549beed3e8a:d21eb7f237156a07:11","timestamp":"2026-09-07T16:40:43.018Z"}
