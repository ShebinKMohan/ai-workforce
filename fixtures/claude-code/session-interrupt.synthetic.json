{
  "provenance": "SYNTHETIC. Hand-built from the record shapes recorded verbatim from claude 2.1.260 (see session-auth-failure.real.json) plus the documented Anthropic message content-block shapes. It is NOT a recording: no turn on the recording machine reached the model, so no real tool_use / tool_result record could be captured. Tests that use this file prove the adapter's framing and normalization, not the runtime's behaviour. The turn produces its opening records and then nothing until an interrupt control request arrives; the terminal record is emitted synchronously from that request, so the test has no timing race.",
  "steps": [
    {
      "on": "user",
      "emit": [
        {
          "type": "system",
          "subtype": "init",
          "cwd": "{{cwd}}",
          "session_id": "{{sessionId}}",
          "tools": [
            "Read",
            "Glob",
            "Grep",
            "Edit",
            "Write"
          ],
          "mcp_servers": [],
          "model": "claude-opus-5[1m]",
          "permissionMode": "acceptEdits",
          "apiKeySource": "none",
          "claude_code_version": "2.1.260",
          "output_style": "default",
          "capabilities": [
            "interrupt_receipt_v1",
            "interrupt_cancel_queued_v1",
            "msg_lifecycle_v1"
          ],
          "uuid": "11111111-1111-4111-8111-111111111111"
        },
        {
          "__replay": true
        },
        {
          "type": "assistant",
          "message": {
            "id": "msg_synthetic",
            "model": "claude-opus-5",
            "role": "assistant",
            "type": "message",
            "stop_reason": null,
            "content": [
              {
                "type": "text",
                "text": "Starting a long search."
              }
            ],
            "usage": {
              "input_tokens": 1200,
              "output_tokens": 40,
              "cache_read_input_tokens": 900,
              "cache_creation_input_tokens": 0
            }
          },
          "parent_tool_use_id": null,
          "session_id": "{{sessionId}}",
          "uuid": "22222222-2222-4222-8222-222222222222",
          "timestamp": "2026-09-07T11:00:00.000Z"
        }
      ]
    },
    {
      "on": "control:interrupt",
      "respond": {
        "still_queued": []
      },
      "emit": [
        {
          "type": "result",
          "subtype": "error_during_execution",
          "session_id": "{{sessionId}}",
          "is_error": true,
          "result": "Interrupted by user",
          "num_turns": 2,
          "duration_ms": 5400,
          "duration_api_ms": 1200,
          "total_cost_usd": 0.0009,
          "usage": {
            "input_tokens": 1200,
            "output_tokens": 40,
            "cache_read_input_tokens": 900,
            "cache_creation_input_tokens": 0,
            "server_tool_use": {
              "web_search_requests": 0,
              "web_fetch_requests": 0
            },
            "service_tier": "standard"
          },
          "modelUsage": {
            "claude-opus-5": {
              "inputTokens": 1200,
              "outputTokens": 40
            }
          },
          "permission_denials": [],
          "queued_turn_count": 0,
          "uuid": "44444444-4444-4444-8444-444444444444",
          "terminal_reason": "interrupted"
        }
      ]
    }
  ]
}
